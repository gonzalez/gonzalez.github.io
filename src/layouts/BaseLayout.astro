---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'gonzalez',
  description = 'Personal garden of gonzalez — writing, projects, and notes under cultivation.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
