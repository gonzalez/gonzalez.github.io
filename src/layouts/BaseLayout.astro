---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'gonzalez',
  description = 'Personal garden of gonzalez — writing, projects, and notes under cultivation.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <!-- Minimal shared nav so every note and directory page is reachable;
         polish (theme toggle, footer) lands with the identity task. -->
    <header class="reading-column">
      <nav aria-label="Site" class="flex gap-4 py-4 text-sm">
        <a href="/">Home</a>
        <a href="/writing/">Writing</a>
        <a href="/projects/">Projects</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <slot />
  </body>
</html>
