---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Newest first; title breaks date ties so the order is deterministic even
// when several notes share a creation date.
const notes = (
  await getCollection('writing', (entry) => !entry.data.draft)
).sort(
  (a, b) =>
    b.data.createdDate.getTime() - a.data.createdDate.getTime() ||
    a.data.title.localeCompare(b.data.title)
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout
  title="Writing — gonzalez"
  description="The garden: notes at seedling, growing, and evergreen maturity."
>
  <main class="reading-column">
    <h1 class="text-3xl font-semibold tracking-tight">Writing</h1>
    <p class="mt-2 text-ink-muted">
      A digital garden. Notes start as <em>seedlings</em>, grow as I learn, and
      become <em>evergreen</em> when I trust them to stay true.
    </p>
    <ol class="mt-8 space-y-8">
      {
        notes.map((note) => (
          <li>
            <h2 class="text-xl font-semibold">
              <a href={`/writing/${note.id}/`}>{note.data.title}</a>
            </h2>
            <p class="mt-1 text-ink-muted">{note.data.description}</p>
            <p class="mt-1 font-mono text-sm text-ink-muted">
              <span data-maturity={note.data.maturity}>{note.data.maturity}</span>
              {' · '}
              <time datetime={note.data.createdDate.toISOString()}>
                {formatDate(note.data.createdDate)}
              </time>
              {note.data.tags.length > 0 && <> · {note.data.tags.join(', ')}</>}
            </p>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
