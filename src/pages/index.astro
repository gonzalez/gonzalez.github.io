---
// Home — a quiet holding page: the DDC wordmark, an accent-ink DDC "more is
// coming soon" headline, a chip, and one short line. The garden (/writing,
// /projects, /about, /experiments, RSS) stays live via the site nav.
import { readFileSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';

// 1x is the natural masthead size; the 2x raster serves retina displays at
// the same CSS size via the density descriptor (no width math in the HTML).
// Both ink variants always ship (TASK-3, plan Review Focus #2): the CSS swap
// (global.css `masthead-word--light/dark`) picks the one matching the active
// theme — prefers-color-scheme, or the ThemeToggle's pinned [data-theme].
const wordmarkWidth = 148;
const wordmarkHeight = 25;
const mastheadVariants = [
  {
    ink: 'light',
    url: `/assets/word/light/gonzalez@1x.png`,
    retina: `/assets/word/light/gonzalez@2x.png`,
  },
  {
    ink: 'dark',
    url: `/assets/word/dark/gonzalez@1x.png`,
    retina: `/assets/word/dark/gonzalez@2x.png`,
  },
] as const;

// TASK-11: the headline carries the astro-inspired accent inks instead of the
// neutral ones (design: accent infusion). Dims come from the committed
// manifest; fail-soft keeps the page building if the manifest is missing.
type Dims = Record<string, Record<string, number[]>>;
let accent: Dims | null = null;
try {
  const manifest = JSON.parse(
    readFileSync(new URL('../../public/assets/word/manifest.json', import.meta.url), 'utf8')
  );
  const entry = manifest['more-is-coming-soon'];
  if (entry?.['accent-light']?.['1'] && entry?.['accent-dark']?.['1']) accent = entry;
} catch {
  /* no manifest — plain-text headline */
}

const accentVariants = [
  { ink: 'accent-light', url: `/assets/word/accent-light/more-is-coming-soon@1x.png`, retina: `/assets/word/accent-light/more-is-coming-soon@2x.png` },
  { ink: 'accent-dark', url: `/assets/word/accent-dark/more-is-coming-soon@1x.png`, retina: `/assets/word/accent-dark/more-is-coming-soon@2x.png` },
] as const;
---

<BaseLayout title="gonzalez — digital garden">
  <main class="reading-column">
    <p class="masthead">
      {
        // Both rasterized ink variants render into the page; the CSS palette
        // swap (global.css) hides one. A display:none keyword image is
        // dropped from the accessibility tree, so each variant carries its
        // own alt text and exactly one is announced per theme.
        mastheadVariants.map((variant) => (
          <img
            class={`masthead-word masthead-word--${variant.ink}`}
            src={variant.url}
            srcset={`${variant.url} 1x, ${variant.retina} 2x`}
            width={wordmarkWidth}
            height={wordmarkHeight}
            alt="gonzalez"
          />
        ))
      }
    </p>

    <p class="mt-8">
      <span class="chip">v2 · rebuilt on astro</span>
    </p>
    <h1 class="text-3xl font-semibold tracking-tight">
      {
        accent ? (
          accentVariants.map((variant) => (
            <img
              class={`heading-word heading-word--${variant.ink}`}
              src={variant.url}
              srcset={`${variant.url} 1x, ${variant.retina} 2x`}
              width={accent[variant.ink]['1'][0]}
              height={accent[variant.ink]['1'][1]}
              alt="more is coming soon"
            />
          ))
        ) : (
          <span>more is coming soon</span>
        )
      }
    </h1>
    <p class="mt-3">
      Glad you're here. Most of the garden is still in the ground — more is
      coming soon.
    </p>
    <p class="terminal-line mt-6" aria-hidden="true">
      git push origin main&nbsp;&nbsp;&nbsp;# publishing is a deliberate push
    </p>
  </main>
</BaseLayout>
