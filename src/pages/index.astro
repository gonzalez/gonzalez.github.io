---
// Home — wordmark, short intro, and the three garden sections per the
// operator spec's IA: Currently Exploring, Selected Projects, Recent Writing.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// 1x is the natural masthead size; the 2x raster serves retina displays at
// the same CSS size via the density descriptor (no width math in the HTML).
const wordmark = '/assets/word/gonzalez@1x.png';
const wordmark2x = '/assets/word/gonzalez@2x.png';

const notes = (
  await getCollection('writing', (entry) => !entry.data.draft)
).sort(
  (a, b) =>
    b.data.createdDate.getTime() - a.data.createdDate.getTime() ||
    a.data.title.localeCompare(b.data.title)
);
const recent = notes.slice(0, 5);

const projects = (await getCollection('projects')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

// Active interests, each one something with real session work behind it —
// nothing here is aspirational copy.
const exploring = [
  'Agentic development outer loops — the setup and checks around a coding agent',
  'Tending this digital garden itself',
  'Deterministic, locally-validated builds — one gate that must pass before anything publishes',
];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout title="gonzalez — digital garden">
  <main class="reading-column">
    <p>
      <img
        src={wordmark}
        srcset={`${wordmark} 1x, ${wordmark2x} 2x`}
        alt="gonzalez"
      />
    </p>
    <p>
      A personal digital garden: notes under cultivation, a small directory of
      projects, and the work behind them — agentic development and
      open-source contributions.
    </p>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Currently Exploring</h2>
      <ul class="mt-2 space-y-1">
        {exploring.map((interest) => <li>{interest}</li>)}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Selected Projects</h2>
      <ul class="mt-2 space-y-3">
        {
          projects.map((project) => (
            <li data-home-entry="project">
              {project.data.github ? (
                <a href={project.data.github}>{project.data.name}</a>
              ) : (
                <strong>{project.data.name}</strong>
              )}
              {' — '}
              {project.data.description}{' '}
              <span class="font-mono text-sm text-ink-muted">
                ({project.data.status})
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm"><a href="/projects/">Full directory</a></p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">Recent Writing</h2>
      <ul class="mt-2 space-y-2">
        {
          recent.map((note) => (
            <li data-home-entry="note">
              <a href={`/writing/${note.id}/`}>{note.data.title}</a>
              <span class="font-mono text-sm text-ink-muted">
                {' '}
                — {note.data.maturity}, {formatDate(note.data.createdDate)}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm"><a href="/writing/">All writing</a></p>
    </section>
  </main>
</BaseLayout>
