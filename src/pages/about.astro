---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeadingWord from '../components/HeadingWord.astro';
---

<BaseLayout
  title="About — gonzalez"
  description="About gonzalez — what this garden is and what's in it."
>
  <main class="reading-column">
    <h1 class="text-3xl font-semibold tracking-tight"><HeadingWord text="About" /></h1>
    <p class="mt-4">
      I'm <strong>gonzalez</strong>. I work on agentic development tooling —
      the <a href="https://github.com/gonzalez/agent-dev-setup">agent-dev-setup</a>
      outer-loop platform.
    </p>
    <p class="mt-4">
      This site is my digital garden: writing that matures from seedling to
      evergreen, a text directory of <a href="/projects/">projects</a>, and an <a
        href="/rss.xml">RSS feed</a
      > for readers who'd rather subscribe than browse. It's a static Astro
      site built locally — publishing is a deliberate push.
    </p>
    <p class="mt-4">
      No analytics, no comments, no database. To reach me,
      <a href="https://github.com/gonzalez">GitHub is the door</a>.
    </p>
  </main>
</BaseLayout>
